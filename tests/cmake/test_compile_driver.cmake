get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${root}/cmake/RunCompileCheck.cmake"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if("${result}" STREQUAL "0")
  message(FATAL_ERROR "Driver accepted absent required arguments")
endif()
string(FIND "${stdout}\n${stderr}" "Missing required compile-check argument" diagnostic)
if(diagnostic EQUAL -1)
  message(FATAL_ERROR "Driver failed for wrong reason:\n${stdout}\n${stderr}")
endif()
