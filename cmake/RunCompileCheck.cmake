foreach(required IN ITEMS ARIADNE_BUILD_DIR ARIADNE_BUILD_TARGET ARIADNE_EXPECT_FAILURE)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing required compile-check argument: ${required}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${ARIADNE_BUILD_DIR}"
  --config "${ARIADNE_BUILD_CONFIG}" --target "${ARIADNE_BUILD_TARGET}"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(ARIADNE_EXPECT_FAILURE)
  if("${result}" STREQUAL "0")
    message(FATAL_ERROR "Negative compile target unexpectedly succeeded")
  endif()
  string(FIND "${stdout}\n${stderr}" "${ARIADNE_EXPECTED_DIAGNOSTIC}" marker)
  if(marker EQUAL -1)
    message(FATAL_ERROR "Compile target failed for the wrong reason. Expected '${ARIADNE_EXPECTED_DIAGNOSTIC}'.\n${stdout}\n${stderr}")
  endif()
elseif(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Compile-only target failed:\n${stdout}\n${stderr}")
endif()
