include_guard(GLOBAL)
set(_ARIADNE_COMPILE_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/RunCompileCheck.cmake")
function(ariadne_add_compile_check)
  cmake_parse_arguments(ARG "EXPECT_FAILURE" "NAME;SOURCE;EXPECTED_DIAGNOSTIC" "LINK_LIBRARIES;LABELS" ${ARGN})
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_NAME OR NOT ARG_SOURCE)
    message(FATAL_ERROR "ariadne_add_compile_check requires NAME and SOURCE")
  endif()
  if(ARG_EXPECT_FAILURE AND NOT ARG_EXPECTED_DIAGNOSTIC)
    message(FATAL_ERROR "Negative compilation check requires EXPECTED_DIAGNOSTIC")
  endif()
  set(_target "ariadne_compile_${ARG_NAME}")
  add_library(${_target} OBJECT EXCLUDE_FROM_ALL "${ARG_SOURCE}")
  target_compile_features(${_target} PRIVATE cxx_std_20)
  if(ARG_LINK_LIBRARIES)
    target_link_libraries(${_target} PRIVATE ${ARG_LINK_LIBRARIES})
  endif()
  add_test(NAME "${ARG_NAME}" COMMAND "${CMAKE_COMMAND}"
    "-DARIADNE_BUILD_DIR=${CMAKE_BINARY_DIR}"
    "-DARIADNE_BUILD_CONFIG=$<CONFIG>"
    "-DARIADNE_BUILD_TARGET=${_target}"
    "-DARIADNE_EXPECT_FAILURE=${ARG_EXPECT_FAILURE}"
    "-DARIADNE_EXPECTED_DIAGNOSTIC=${ARG_EXPECTED_DIAGNOSTIC}"
    -P "${_ARIADNE_COMPILE_SCRIPT}")
  set_tests_properties("${ARG_NAME}" PROPERTIES RUN_SERIAL TRUE TIMEOUT 90 LABELS "compile;${ARG_LABELS}")
endfunction()
function(ariadne_add_cmake_script_test)
  cmake_parse_arguments(ARG "" "NAME;SCRIPT" "LABELS" ${ARGN})
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_NAME OR NOT ARG_SCRIPT)
    message(FATAL_ERROR "ariadne_add_cmake_script_test requires NAME and SCRIPT")
  endif()
  add_test(NAME "${ARG_NAME}" COMMAND "${CMAKE_COMMAND}" -P "${ARG_SCRIPT}")
  set_tests_properties("${ARG_NAME}" PROPERTIES LABELS "cmake;${ARG_LABELS}")
endfunction()
function(ariadne_add_python_unittest_test)
  cmake_parse_arguments(ARG "" "NAME;DIRECTORY;PATTERN" "LABELS" ${ARGN})
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_NAME OR NOT ARG_DIRECTORY)
    message(FATAL_ERROR "ariadne_add_python_unittest_test requires NAME and DIRECTORY")
  endif()
  find_package(Python3 QUIET COMPONENTS Interpreter)
  if(NOT Python3_Interpreter_FOUND)
    message(STATUS "Optional Python unittest '${ARG_NAME}' not registered (no interpreter)")
    return()
  endif()
  if(NOT ARG_PATTERN)
    set(ARG_PATTERN "test_*.py")
  endif()
  add_test(NAME "${ARG_NAME}" COMMAND "${Python3_EXECUTABLE}" -m unittest discover -s "${ARG_DIRECTORY}" -p "${ARG_PATTERN}")
  set_tests_properties("${ARG_NAME}" PROPERTIES LABELS "python;${ARG_LABELS}")
endfunction()
